# Copy to `.env.local` and fill in values. Vite only exposes VITE_* vars to the client.
# Do not put secrets that must stay private in VITE_* variables — they are bundled into the frontend.

# WalletConnect Cloud / Reown project ID (required for WalletConnect wallets).
# Create one at https://cloud.reown.com/  (injected wallets like MetaMask still work without this)
VITE_WALLETCONNECT_PROJECT_ID=

# Optional Alchemy API key for more reliable RPC (falls back to public RPC if empty)
# https://www.alchemy.com/
VITE_ALCHEMY_API_KEY=

# Target chain: 1 = Ethereum mainnet, 11155111 = Sepolia
VITE_CHAIN_ID=1

# ERC-20 token used by the Permit2 transfer form (must already exist on the target chain)
VITE_TOKEN_ADDRESS=

# Canonical Uniswap Permit2. Override only if you are targeting a fork/custom deployment.
# Same address on Ethereum, Sepolia, and most EVM chains:
# 0x000000000022D473030F116dFC393057B8271cAA
VITE_PERMIT2_ADDRESS=0x000000000022D473030F116dFC393057B8271cAA

# Placeholder custom contract for the second tab. Replace with a real deployed address
# and update src/config/customContract.ts ABI before sending transactions.
VITE_CUSTOM_CONTRACT_ADDRESS=
VITE_CUSTOM_CONTRACT_CHAIN_ID=1
